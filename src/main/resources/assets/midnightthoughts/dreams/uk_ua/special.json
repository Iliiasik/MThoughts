{
  "entries": [
    {
      "text": "Прокинься.",
      "rarity": 0.05
    },
    {
      "text": "Вони спостерігають.",
      "rarity": 0.03
    },
    {
      "text": "Це не сон.",
      "rarity": 0.04
    },
    {
      "text": "Не обертайся.",
      "rarity": 0.03
    },
    {
      "text": "Ніч пам'ятає все.",
