    },
    {
      "text": "Ти вже був тут.",
      "rarity": 0.04
    },
    {
      "text": "Щось стоїть за твоєю спиною.",
      "rarity": 0.02
    },
    {
      "text": "Безодня дивиться у відповідь.",
      "rarity": 0.03
    },
    {
      "text": "Тут не існує часу.",
      "rarity": 0.05
    },
    {
      "text": "Ти залишив двері відчиненими.",
      "rarity": 0.04
    },
    {
      "text": "Це не гра.",
      "rarity": 0.04
    },
    {
      "text": "Ти не один.",
      "rarity": 0.03
    },
    {
      "text": "Симуляція дає збій.",
      "rarity": 0.02
    },
    {
      "text": "Зазирни за завісу.",
      "rarity": 0.03
    },
    {
      "text": "У шепоту є ім'я.",
      "rarity": 0.02
    },
    {
      "text": "Не вір своїм очам.",
      "rarity": 0.04
    },
    {
      "text": "Небо — це брехня.",
      "rarity": 0.03
    },
    {
      "text": "Монстр — це ти.",
      "rarity": 0.01
    },
    {
      "text": "Стіни дихають.",
      "rarity": 0.02
