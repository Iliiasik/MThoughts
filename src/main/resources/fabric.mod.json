{
  "schemaVersion": 1,
  "id": "midnightthoughts",
  "version": "${version}",
  "name": "Midnight Thoughts",
  "description": "Diversify your gameplay and sleep mechanics with a comfort system, bedtime facts, nightmares, and general statistics since your last sleep. With full server support and convenient tools for building your world's lore through sleep facts and achievements",
  "icon": "midnightthoughts_icon.png",
  "authors": ["Iliiasik"],
  "contact": {
    "homepage": "https://iliiasik.github.io/MThoughts-Wiki/",
    "sources": "https://github.com/Iliiasik/MThoughts",
    "issues": "https://github.com/Iliiasik/MThoughts/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "mt.MidnightThoughts"
    ],
    "client": [
      "mt.client.MidnightThoughtsClient"
    ]
  },
  "mixins": [
    "midnightthoughts.mixins.json",
    {
      "config": "midnightthoughts.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "java": ">=21"
  },
  "custom": {
    "catalogue": {
      "banner": "midnightthoughts_banner.png",
      "background": "midnightthoughts_background.png"
    }
  }
}
